BACKUP ~weidu_external/cdtweaks_helper/backup~ // location to store files for
AUTHOR ~pcamagna@yahoo.com~ // email address displayed if install fails

VERSION ~v2025.08.01~

README ~cdtweaks_helper/readme-cdtweaks_helper.html~

LANGUAGE
  ~English~
  ~english~
  ~cdtweaks_helper/languages/english/weidu.tra~

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// generate armor list                              \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

BEGIN @0
NO_LOG_RECORD

<<<<<<<<./inline/install.tpa
//%MOD_FOLDER% version: %MOD_VERSION%%install%
>>>>>>>>

<<<<<<<<./inline/helper.csv
%csv%
>>>>>>>>

ACTION_IF FILE_EXISTS ~cdtweaks/lib/common_armor_array.tpa~ BEGIN

  INCLUDE ~cdtweaks/lib/common_armor_array.tpa~
  COPY ~cdtweaks/lib/common_armor_array.tpa~ ~weidu_external/cdtweaks_helper/email_to_cam/common_armor_array_cdtweaks.tpa~
  
END  

ACTION_IF FILE_EXISTS ~weidu-bgee.log~ BEGIN

  COPY ~weidu-bgee.log~ ~weidu_external/cdtweaks_helper/email_to_cam/weidu-bgee.log~
  
END  

COPY ~weidu.log~ ~weidu_external/cdtweaks_helper/email_to_cam/weidu.log~

INCLUDE ~cdtweaks_helper/lib/common_armor_array.tpa~
COPY ~cdtweaks_helper/lib/common_armor_array.tpa~ ~weidu_external/cdtweaks_helper/email_to_cam/common_armor_array_helper.tpa~

ACTION_PHP_EACH cd_common_armor_list_full AS params => item BEGIN

  OUTER_SET $armor("%item%") = 1
  
END

INCLUDE ~cdtweaks_helper/lib/cdtweaks_helper_macro.tpa~

OUTER_SET email = 0
OUTER_SPRINT install ~~
OUTER_SPRINT csv ~~
COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~weidu_external/cdtweaks_helper/email_to_cam~
  READ_SHORT 0x1c type  ELSE 0
  READ_BYTE  0x18 flags ELSE 0
  SPRINT item ~%SOURCE_RES%~
  TO_LOWER item
  PATCH_IF (((type = 2) OR (type = 12) OR (type = 41) OR (type = 47) OR (type = 49) OR (type = 53)) AND // type is armor (2) or shield (12 in bg, rest are iwd values)
            ((flags & BIT2) = BIT2)     AND            // is flagged as droppable
            (!VARIABLE_IS_SET $armor("%item%"))) BEGIN // not already in the list            
    LPM cdtweaks_helper
  END
  BUT_ONLY

ACTION_IF email BEGIN

  COPY ~./inline/install.tpa~ ~weidu_external/cdtweaks_helper/email_to_cam/install.tpa~ EVALUATE_BUFFER
  COPY ~./inline/helper.csv~  ~weidu_external/cdtweaks_helper/email_to_cam/helper.csv~  EVALUATE_BUFFER
    REPLACE_TEXTUALLY ~"~ ~\"~ // escape any legit quotes in names
    REPLACE_TEXTUALLY ~CDQUOTE~ ~"~ // wrap in quotes for import

  PRINT @3
  
END ELSE BEGIN

  PRINT @4
  
END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// for cam to test these locally                    \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

BEGIN @1 
REQUIRE_PREDICATE FILE_EXISTS ~cdtweaks_helper/local/local.txt~ @2

GET_DIRECTORY_ARRAY directories ~cdtweaks_helper/local~ ~.+~
ACTION_PHP_EACH directories AS index => path BEGIN

  ACTION_IF ("%path%" STRING_COMPARE_REGEXP "^cdtweaks_helper/local/[^.].+$" = 0) BEGIN // exclude . and ..
  
    PRINT ~Installing %path% ... ~
    
    INCLUDE ~%path%/install.tpa~
    
    ACTION_IF !FILE_EXISTS ~%path%/helper.csv~ AND FILE_EXISTS ~%path%/proposed.tpa~ BEGIN // cnovert older tpa to csv
    
      COPY ~%path%/proposed.tpa~ ~%path%/helper.csv~
        REPLACE_TEXTUALLY ~^ +~ ~~
        REPLACE_TEXTUALLY ~, +~ ~,~
        REPLACE_TEXTUALLY ~" +=>.+"[^"]+" +//\(.+\)$~ ~","\1"~
      
    END  
    
    ACTION_IF FILE_EXISTS ~%path%/helper.csv~ BEGIN // if newer version with csv
    
      ACTION_IF FILE_EXISTS ~cdtweaks_helper/local/combined.csv~ BEGIN
      
        COPY ~cdtweaks_helper/local/combined.csv~ ~cdtweaks_helper/local/combined.csv~
          APPEND_FILE ~%path%/helper.csv~
          
      END ELSE BEGIN     
      
        COPY ~%path%/helper.csv~ ~cdtweaks_helper/local/combined.csv~
        
      END  
      
    END   
    
  END  
  
END 
