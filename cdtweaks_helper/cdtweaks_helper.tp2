END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// for cam to test these locally                    \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\


BEGIN ~Cam installs locally~
DEPRECATED ~internal use only~

GET_DIRECTORY_ARRAY directories ~cdtweaks_helper/local~ ~.+~
ACTION_PHP_EACH directories AS index => path BEGIN

  ACTION_IF ("%path%" STRING_COMPARE_REGEXP "^cdtweaks_helper/local/[^.].+$" = 0) BEGIN // exclude . and ..
  
    PRINT ~Installing %path% ... ~
    
    INCLUDE ~%path%/install.tpa~
    
    ACTION_IF !FILE_EXISTS ~%path%/helper.csv~ AND FILE_EXISTS ~%path%/proposed.tpa~ BEGIN // cnovert older tpa to csv
    
      COPY ~%path%/proposed.tpa~ ~%path%/helper.csv~
        REPLACE_TEXTUALLY ~^ +~ ~~
        REPLACE_TEXTUALLY ~, +~ ~,~
        REPLACE_TEXTUALLY ~" +=>.+"[^"]+" +//\(.+\)$~ ~","\1"~
      
    END  
    
    ACTION_IF FILE_EXISTS ~%path%/helper.csv~ BEGIN // if newer version with csv
    
      ACTION_IF FILE_EXISTS ~cdtweaks_helper/local/combined.csv~ BEGIN
      
        COPY ~cdtweaks_helper/local/combined.csv~ ~cdtweaks_helper/local/combined.csv~
          APPEND_FILE ~%path%/helper.csv~
          
      END ELSE BEGIN     
      
        COPY ~%path%/helper.csv~ ~cdtweaks_helper/local/combined.csv~
        
      END  
      
    END   
    
  END  
  
END 
